import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/async/stdio",
  "moonbitlang/core/argparse",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/random",
  "KKKIIO/pi/sdk/coding_agent",
  "KKKIIO/pi/sdk/providers",
  "KKKIIO/pi/sdk/agent_loop",
  "KKKIIO/pi/sdk/agent_session",
}

pkgtype(kind: "executable")

// glibc < 2.34 keeps pthread symbols in libpthread instead of libc; link it
// explicitly so pim runs on debian:bullseye (glibc 2.31) task images.
// Harmless on glibc >= 2.34, where libpthread is a stub.

supported_targets = "+native"

options(
  link: { "native": { "cc-link-flags": "-lpthread -ldl" } },
)
